    "id": "en-de-th-d",
    "pair": "en-de",
    "rule": "th → d",
    "ipa": "/θ/ → /d/",
    "title": "English th becomes German d",
    "explanation": "Grimm's Law: the Proto-Indo-European sound *dh became Germanic *d, which stayed d in German but spirantized to th in English. So almost any English word with 'th' has a German cousin with a plain 'd'.",
    "unlocks": 1840,
    "examples": [
      { "en": "brother", "other": "Bruder" },
      { "en": "feather", "other": "Feder" },
      { "en": "weather", "other": "Wetter" },
      { "en": "thank", "other": "danken" },
      { "en": "three", "other": "drei" },
      { "en": "think", "other": "denken" },
      { "en": "mother", "other": "Mutter" },
      { "en": "father", "other": "Vater" },
      { "en": "bath", "other": "Bad" },
      { "en": "cloth", "other": "Kleid" }
    ]
  },
